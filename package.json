{
  "name": "@ghchinoy/livebridge",
  "version": "0.1.4",
  "description": "Zero-dependency browser & Lit client kit for real-time Gemini Live voice, talking video avatars, 1 FPS vision, WebMCP page tools, and proactive alerts — paired with the Go livebridge switchboard.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghchinoy/livebridge.git"
  },
  "homepage": "https://github.com/ghchinoy/livebridge#readme",
  "bugs": {
    "url": "https://github.com/ghchinoy/livebridge/issues"
  },
  "keywords": [
    "gemini",
    "gemini-live",
    "vertex-ai",
    "avatar",
    "web-audio",
    "mse",
    "fmp4",
    "webmcp",
    "websocket",
    "lit"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lit": {
      "types": "./dist/lit/index.d.ts",
      "import": "./dist/lit/index.js"
    },
    "./browser": "./browser/dist/livebridge.esm.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "browser/dist",
    "ts",
    "!ts/**/*.test.ts",
    "!ts/__tests__",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "workspaces": [
    "examples/02-avatar-desk/frontend",
    "examples/04-ops-watchtower/frontend"
  ],
  "scripts": {
    "build:esm": "tsc -p tsconfig.build.json",
    "build:browser": "vite build --config vite.bundle.config.ts",
    "build": "npm run build:esm && npm run build:browser",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"ts/**/*.ts\" \"*.ts\" \"*.json\"",
    "format:check": "prettier --check \"ts/**/*.ts\" \"*.ts\" \"*.json\"",
    "lint": "npm run typecheck && npm run format:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "lit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/browser-playwright": "^5.1.1",
    "lit": "^3.3.3",
    "playwright": "^1.63.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
